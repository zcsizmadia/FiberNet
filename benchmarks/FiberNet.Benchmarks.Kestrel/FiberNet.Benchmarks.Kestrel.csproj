<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsAotCompatible>false</IsAotCompatible>
    <Optimize>true</Optimize>
    <!-- BDN needs public non-sealed classes; owns disposable fields cleaned up via [GlobalCleanup] -->
    <NoWarn>$(NoWarn);CA1515;CA1812;CA1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <ProjectReference Include="..\..\src\FiberNet.Transport.Kestrel\FiberNet.Transport.Kestrel.csproj" />
  </ItemGroup>
</Project>
