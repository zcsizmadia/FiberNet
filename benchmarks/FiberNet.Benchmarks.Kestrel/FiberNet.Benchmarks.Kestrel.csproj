<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <IsAotCompatible>false</IsAotCompatible>
    <Optimize>true</Optimize>
    <!-- CA1515: internal types in exe; CA2000: SocketsHttpHandler lifetime is owned by HttpClient -->
    <!-- CA1303: display-only strings; no localization needed for a benchmark tool          -->
    <NoWarn>$(NoWarn);CA1515;CA2000;CA1303</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FiberNet.Transport.Kestrel\FiberNet.Transport.Kestrel.csproj" />
    <ProjectReference Include="..\..\src\FiberNet.Transport.Kestrel.IoUring\FiberNet.Transport.Kestrel.IoUring.csproj" />
  </ItemGroup>
</Project>
